{
  "name": "iitr-conference-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run validate:content && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint scripts && prettier --check src scripts tests vite.config.ts index.html eslint.config.mjs",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.mjs",
    "report:placeholders": "node scripts/report-placeholders.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "make:placeholders": "node scripts/make-placeholders.mjs",
    "capture:screenshots": "npm run build && node scripts/verify-design.mjs --local",
    "format": "prettier --write src scripts tests vite.config.ts index.html eslint.config.mjs",
    "check:html": "node scripts/check-html.mjs"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
